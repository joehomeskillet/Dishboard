# Diese Datei nach .env kopieren. Operatoren duerfen jeden Wert gezielt ueberschreiben.
IMAGE_TAG=local
APP_ENV=development
APP_HOST_PORT=8080
APP_PUBLIC_BASE_URL=https://dishboard.joelduss.xyz
DEMO_MODE=true
SEED_DEMO=true
DEMO_TODAY=2026-09-01
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=28800
MAX_UPLOAD_BYTES=5242880
TRUSTED_PROXY_HOPS=1
FRAME_ANCESTORS='self'
LAST_GOOD_DIR=/var/lib/cafeteria/last-good
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30

# PostgreSQL
POSTGRES_DB=cafeteria
POSTGRES_SSLMODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=35

# Produktivwerte: APP_ENV=production, DEMO_MODE=false, SEED_DEMO=false,
# DEMO_TODAY leer, HTTPS-URL und reale Entra-IDs. Entra erst aktivieren,
# wenn Tenant-ID, Client-ID und Docker Secret vom Operator gesetzt wurden.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
CAFETERIA_DOMAIN=dishboard.joelduss.xyz
